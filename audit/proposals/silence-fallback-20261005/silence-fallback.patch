@@ -0,0 +1,296 @@
+"""Draft policy checks. Manual monotonic time is controlled; no live silence claim."""
+import asyncio
+import copy
+import unittest
+from tests.test_speech_pipeline import SpeechHarness, QUESTION, FOLLOWUP, ANSWER
+from runtime_probe import wait_for
+from smart_turn import ReadyTurnFrame, EndOfTurnState, MAX_FRAGMENTS
+
+class SilenceFallbackTests(unittest.IsolatedAsyncioTestCase):
+    async def paused(self, route, *, final=True):
+        h = await SpeechHarness(route).start()
+        h.clock = [100.0]
+        h.session.turn.clock = lambda: h.clock[0]
+        h.provider.turn_decisions = [False]
+        await h.inner.begin(QUESTION, 0)
+        await h.inner.finish(QUESTION, 0, final=final)
+        await wait_for(lambda: h.session.turn.decision == EndOfTurnState.INCOMPLETE,
+                       "controlled incomplete detector decision")
+        h.original_pause = h.session.turn.pause_end
+        h.observed_cursor = h.session.turn.pause_observed_cursor
+        return h
+
+    async def audio(self, h, seconds):
+        remaining = round(seconds * 32000)
+        while remaining:
+            size = min(16000, remaining)
+            await h.session.audio(bytes(size))
+            remaining -= size
+
+    async def empty(self, h, start=None, end=None, *, final=False, words=None):
+        await h.session.provider_event({"type":"Results", "start":
+            h.original_pause / 16000 if start is None else start,
+            "duration": (h.provider.audio_cursor if end is None else end) -
+                        (h.original_pause / 16000 if start is None else start),
+            "is_final":final, "speech_final":False,
+            "channel":{"alternatives":[{"transcript":"", "words":[] if words is None else words}]},
+            "connection_generation":h.provider.connection_generation})
+
+    async def no_response(self, h):
+        await asyncio.sleep(.03)
+        self.assertEqual(h.provider.generations, [])
+        self.assertFalse(any(m["role"] == "user" for m in h.session.context.get_messages()))
+
+    async def completes_once(self, route):
+        h = await self.paused(route)
+        try:
+            h.clock[0] += 2.98
+            await self.audio(h, 2.98)
+            await self.empty(h)
+            await self.no_response(h)
+            h.clock[0] += .020001
+            await self.audio(h, .02)
+            await self.empty(h)
+            await h.complete()
+            self.assertEqual(h.session.turn.consumed, h.original_pause)
+            self.assertEqual(len(h.provider.turn_checks), 1)
+            model = [m for m in h.session.metrics if m["event"] == "smart_turn"]
+            self.assertEqual([m["complete"] for m in model], [False])
+            ends = [m for m in h.session.metrics if m["event"] == "user_end"]
+            self.assertEqual([m["completion_reason"] for m in ends], ["silence_timeout"])
+            self.assertEqual(h.provider.generations[0][-1]["content"], QUESTION)
+            await self.empty(h)
+            await self.empty(h, final=True)
+            await asyncio.sleep(.03)
+            self.assertEqual(len(h.provider.generations), 1)
+            await h.turn(FOLLOWUP, 1)
+            await h.complete(2)
+            self.assertEqual(h.provider.generations[1][-2:], [
+                {"role":"assistant", "content":ANSWER}, {"role":"user", "content":FOLLOWUP}])
+        finally:
+            await h.close()
+
+    async def insufficient(self, route, missing):
+        h = await self.paused(route, final=missing != "final_user_text")
+        try:
+            h.clock[0] += (5.001 if missing == "deadline" else
+                           3.001 if missing != "wall_time" else 0)
+            if missing != "forwarded_audio":
+                await self.audio(h, 3)
+            if missing == "empty_progress":
+                pass
+            elif missing == "coverage_gap":
+                await self.empty(h, start=h.original_pause / 16000 + .1)
+            elif missing == "old_progress":
+                await self.empty(h, end=h.original_pause / 16000)
+            elif missing == "forwarded_audio":
+                await self.empty(h, end=h.original_pause / 16000)
+            else:
+                await self.empty(h)
+            await self.no_response(h)
+            # The existing absolute readiness deadline still discards the turn.
+            h.session.turn.timeout = .01
+            await h.session.turn._expire(h.session.turn.revision)
+            await wait_for(lambda: any(e.get("type") == "error" for e in h.events), "readiness abort")
+            self.assertEqual(h.provider.generations, [])
+        finally:
+            await h.close()
+
+    async def resumed(self, route, queued):
+        h = await self.paused(route)
+        entered, release = asyncio.Event(), asyncio.Event()
+        if queued:
+            @h.session.user.event_handler("on_before_process_frame")
+            async def hold_ready(processor, frame):
+                if isinstance(frame, ReadyTurnFrame) and not entered.is_set():
+                    entered.set()
+                    await release.wait()
+        try:
+            h.clock[0] += 3.001 if queued else 2.98
+            await self.audio(h, 3 if queued else 2.98)
+            await self.empty(h)
+            if queued:
+                await asyncio.wait_for(entered.wait(), 3)
+            await h.inner.begin("and the remainder.", 1, resume=True)
+            release.set()
+            await self.no_response(h)
+            self.assertEqual(h.session.turn.silence_ranges, [])
+            # Empty progress never became transcript text. Final coverage of
+            # the resumed speech must span from Nova's previous final cursor.
+            final = h.inner.result("and the remainder.", 1)
+            final["start"] = h.original_pause / 16000
+            final["duration"] = h.provider.audio_cursor - final["start"]
+            await h.session.provider_event(final)
+            await h.complete()
+            self.assertEqual(len(h.provider.generations), 1)
+            self.assertEqual(h.provider.generations[0][-1]["content"], QUESTION + " and the remainder.")
+            self.assertEqual([m["completion_reason"] for m in h.session.metrics if m["event"] == "user_end"], ["smart_turn"])
+        finally:
+            release.set()
+            await h.close()
+
+    async def resumed_complete(self, route):
+        h = await self.paused(route)
+        try:
+            h.clock[0] += 2.98
+            await self.audio(h, 2.98)
+            await self.empty(h)
+            await h.inner.begin("and the remainder.", 1, resume=True)
+            await self.no_response(h)
+            self.assertEqual(h.session.turn.silence_ranges, [])
+            event = h.inner.result("and the remainder.", 1)
+            event["start"] = h.original_pause / 16000
+            event["duration"] = h.provider.audio_cursor - event["start"]
+            await h.session.provider_event(event)
+            await h.complete()
+            self.assertEqual(h.provider.generations[0][-1]["content"], QUESTION + " and the remainder.")
+            self.assertEqual([m["completion_reason"] for m in h.session.metrics if m["event"] == "user_end"], ["smart_turn"])
+        finally:
+            await h.close()
+
+    async def invalidated(self, route, reason):
+        h = await self.paused(route)
+        try:
+            h.clock[0] += 3.001
+            await self.audio(h, 3)
+            if reason == "reconnect":
+                await h.provider.reconnect()
+            elif reason == "end":
+                await h.session.close("ended")
+            elif reason == "new_text":
+                event={"type":"Results", "start":h.original_pause/16000, "duration":3,
+                    "is_final":False,"speech_final":False,
+                    "channel":{"alternatives":[{"transcript":"More speech", "words":
+                        [{"start":h.original_pause/16000, "end":h.provider.audio_cursor}]}]},
+                    "connection_generation":h.provider.connection_generation}
+                await h.session.provider_event(event)
+            await self.empty(h)
+            await self.no_response(h)
+        finally:
+            await h.close()
+
+    async def held_detector(self, route):
+        h = await SpeechHarness(route).start()
+        clock=[100.0]
+        h.session.turn.clock=lambda:clock[0]
+        h.provider.turn_gate=asyncio.Event()
+        h.provider.turn_decisions=[False]
+        try:
+            await h.turn()
+            await h.provider.turn_started.wait()
+            h.original_pause=h.session.turn.pause_end
+            clock[0]+=3.001
+            await self.audio(h,3)
+            await self.empty(h)
+            await self.no_response(h)
+            h.session.turn.timeout=.01
+            await h.session.turn._expire(h.session.turn.revision)
+            h.provider.turn_gate.set()
+            await self.no_response(h)
+        finally:
+            h.provider.turn_gate.set()
+            await h.close()
+
+    async def queued_deadline(self, route):
+        h = await self.paused(route)
+        entered, release = asyncio.Event(), asyncio.Event()
+        @h.session.user.event_handler("on_before_process_frame")
+        async def hold_ready(processor, frame):
+            if isinstance(frame, ReadyTurnFrame) and not entered.is_set():
+                entered.set()
+                await release.wait()
+        try:
+            h.clock[0] += 3.001
+            await self.audio(h, 3)
+            await self.empty(h)
+            await asyncio.wait_for(entered.wait(), 3)
+            revision = h.session.turn.revision
+            h.session.turn.timeout = .01
+            await h.session.turn._expire(revision)
+            release.set()
+            await self.no_response(h)
+            self.assertFalse(h.session.turn.ready(revision))
+        finally:
+            release.set()
+            await h.close()
+
+    async def detector_error(self, route):
+        h = await SpeechHarness(route).start()
+        clock = [100.0]
+        h.session.turn.clock = lambda: clock[0]
+        h.provider.turn_decisions = [RuntimeError("controlled detector failure")]
+        try:
+            await h.turn()
+            await wait_for(lambda: any(e.get("type") == "error" for e in h.events), "detector error")
+            h.original_pause = round(h.provider.audio_cursor * 16000)
+            clock[0] += 3.001
+            await self.audio(h, 3)
+            await self.empty(h)
+            await self.no_response(h)
+            self.assertFalse(any(m["event"] == "user_end" for m in h.session.metrics))
+        finally:
+            await h.close()
+
+    async def invalid_empty(self, route):
+        h = await self.paused(route)
+        try:
+            h.clock[0] += 3.001
+            await self.audio(h, 3)
+            await self.empty(h, end=h.provider.audio_cursor + .1)
+            await self.no_response(h)
+            self.assertTrue(any(m["event"] == "turn_discarded" and m["reason"] == "invalid_nova_event"
+                                for m in h.session.metrics))
+        finally:
+            await h.close()
+
+    async def gapped_user_final(self, route):
+        h = await SpeechHarness(route).start()
+        h.clock = [100.0]
+        h.session.turn.clock = lambda: h.clock[0]
+        h.provider.turn_decisions = [False]
+        try:
+            await h.inner.begin("", 0)
+            await h.inner.input_segment(1)
+            await h.inner.finish("second part.", 1)
+            await wait_for(lambda: h.session.turn.decision == EndOfTurnState.INCOMPLETE,
+                           "incomplete with gapped final transcript")
+            h.original_pause = h.session.turn.pause_end
+            h.clock[0] += 3.001
+            await self.audio(h, 3)
+            await self.empty(h)
+            await self.no_response(h)
+            self.assertFalse(h.session.turn._covered())
+            await h.inner.finish("First part and", 0, pause=False)
+            await h.complete()
+            self.assertEqual(h.provider.generations[0][-1]["content"], "First part and second part.")
+            self.assertEqual([m["completion_reason"] for m in h.session.metrics if m["event"] == "user_end"], ["silence_timeout"])
+        finally:
+            await h.close()
+
+    async def test_empty_progress_ranges_remain_bounded(self):
+        h = await self.paused("websocket")
+        try:
+            await self.audio(h, 3)
+            for index in range(100):
+                start = h.original_pause / 16000 + index * .02
+                await self.empty(h, start=start, end=start + .01)
+            self.assertLessEqual(len(h.session.turn.silence_ranges), MAX_FRAGMENTS)
+            self.assertEqual(h.session.turn.segments, {(0, h.original_pause): QUESTION})
+            await self.no_response(h)
+        finally:
+            await h.close()
+
+
+def install_cases():
+    for route in ("websocket","sfu"):
+        cases=[("completes_once",()),("resumed_complete",()),("held_detector",()),("queued_deadline",()),("detector_error",()),("invalid_empty",()),("gapped_user_final",())]
+        cases += [("insufficient",(x,)) for x in ("wall_time","deadline","forwarded_audio","empty_progress","coverage_gap","old_progress","final_user_text")]
+        cases += [("invalidated",(x,)) for x in ("reconnect","end","new_text")]
+        cases += [("resumed",(True,))]
+        for helper,args in cases:
+            async def run(self,route=route,helper=helper,args=args):
+                await getattr(self,helper)(route,*args)
+            name="test_"+route+"_"+helper+("_"+str(args[0]) if args else "")
+            setattr(SilenceFallbackTests,name,run)
+install_cases()
+if __name__ == '__main__': unittest.main()
