"""Pinned English Punkt tables interpreted by the normally installed NLTK.

Generated by scripts/vendor_pipecat.py from the Task 1 reference data archive.
See VENDOR_MANIFEST.json for hashes and PUNKT-README.txt for upstream attribution.
This loader is a local compatibility addition, not upstream Pipecat source.
"""
from functools import cache
from io import StringIO

DATA = __PUNKT_DATA__


@cache
def tokenizer():
    from nltk.tabdata import PunktDecoder
    from nltk.tokenize.punkt import PunktParameters, PunktSentenceTokenizer
    decoder = PunktDecoder()
    params = PunktParameters()
    params.collocations = decoder.tab2tups(StringIO(DATA["collocations.tab"]))
    params.sent_starters = decoder.txt2set(StringIO(DATA["sent_starters.txt"]))
    params.abbrev_types = decoder.txt2set(StringIO(DATA["abbrev_types.txt"]))
    params.ortho_context = decoder.tab2intdict(StringIO(DATA["ortho_context.tab"]))
    return PunktSentenceTokenizer(params)


def sentence_tokenize(text):
    return tokenizer().tokenize(text)
